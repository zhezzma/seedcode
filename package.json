{
  "name": "seedcode",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "tcs": " vue-tsc --noEmit &&  tsc --noEmit --skipLibCheck",
    "build": "npm run tcs && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "stage": "powershell -ExecutionPolicy Bypass -File scripts/package-desktop.ps1 -StageOnly  &&  npm run tauri dev -- --config src-tauri/tauri.dev.conf.json",
    "keystore:encrypt": "node scripts/keystore-crypt.mjs encrypt",
    "keystore:decrypt": "node scripts/keystore-crypt.mjs decrypt"
  },
  "dependencies": {
    "@choochmeque/tauri-plugin-notifications-api": "^0.5.0-rc.13",
    "@heroicons/vue": "^2.2.0",
    "@noble/ed25519": "^3.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-websocket": "^2.4.2",
    "@vscode/markdown-it-katex": "^1.1.2",
    "@vueuse/core": "^14.2.1",
    "dotenv": "^17.2.3",
    "highlight.js": "^11.11.1",
    "mammoth": "^1.11.0",
    "markdown-it": "^14.1.0",
    "markdown-it-highlightjs": "^4.2.0",
    "markdown-it-link-attributes": "^4.0.1",
    "mermaid": "^11.12.2",
    "monaco-editor": "^0.55.1",
    "pdfjs-dist": "^5.4.624",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.13",
    "vue-i18n": "^11.2.8",
    "vue-router": "^5.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-link-attributes": "^3.0.5",
    "@types/node": "^25.2.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "daisyui": "^5.5.16",
    "esbuild": "^0.25.12",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.2.12"
  }
}
